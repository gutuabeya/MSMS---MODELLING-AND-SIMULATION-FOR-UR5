</Information>';
       type Integrate
        ports
         signal in input;
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 376 232 408 264 color 0 fill 15132390;
         text '∫' 392 248.3 color 16711680 'Lucida Sans' 21 italic;
       end;
       implementation eq
parameters
	real global theta0_a[6];
	real global theta_d[6];
variables
	real initial;
	real error;
initialequations
	initial=	theta0_a[1];
equations
	output = int(input,initial);
	error = theta_d[1] - output;
     implementation_end;
      MTF1 472 136
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type 'MTF-3'
        ports
         power in p1 [3,1];
         power out p2 [3,1];
         signal in theta1;
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 472 136 color 0 18 bold;
       end;
       implementation eq
variables
	real R01[3,3];
equations					
   R01 = [ cos(theta1),    -sin(theta1),     0;
           sin(theta1),     cos(theta1),      0;
           0,                     0,         1];


   p2.e = transpose(R01)*p1.e;
   p1.f = R01 * p2.f;

implementation_end;
