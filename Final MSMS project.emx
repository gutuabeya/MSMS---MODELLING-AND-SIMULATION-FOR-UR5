       end;
       implementation eq
parameters
	real global alpha_a[6];
	real global a_a[6];

variables
  	real omega[3, 1], v[3,1];
	real p[3, 1], h[3, 1];
	real global H06[4,4];
  	real P0G[3,1];
  	real R0G[3,3];
	real global T_FF6_G[4,4];
	real H_FF_G[4,4];
	real H_CoG[4,4];

equations
	H_FF_G = H06*T_FF6_G;
	P0G = H_FF_G[1:3,4];
	R0G = H_FF_G[1:3,1:3];
	
	omega = rot.f;   
