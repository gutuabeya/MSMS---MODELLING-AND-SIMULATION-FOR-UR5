       type 'Submodel-Equation'
        ports
         power in tran [3,1];
         power in rot [3,1];
         signal out R_OG [3,3];
         signal out P_OG [3,1];
        parameters
         real m3 = 2.33;
         real J3[3,3] = [0.0025, 0.0, 0.0034; 0.0, 0.0551, 0.0; 0.0034, 0.0, 0.0546];
       end;
       implementation eq
parameters
	real global alpha_a[6];
	real global a_a[6];

variables
  	real omega[3, 1], v[3,1];
	real p[3, 1], h[3, 1];
	real global H03[4,4];
  	real P0G[3,1];
  	real R0G[3,3];
	real global T_FF3_G[4,4];
	real H_FF_G[4,4];
	real H_CoG[4,4];	

equations
	H_FF_G = H03*T_FF3_G;
	P0G = H_FF_G[1:3,4];
	R0G = H_FF_G[1:3,1:3];
	
	omega = rot.f;   
	v = tran.f; 
	
	p= int(tran.e - skew(omega)*p);
	h= int(rot.e - skew(omega)*h);
	
  	tran.f = p/m3;
  	rot.f =  inverse(J3)*h;

  	R_OG = int(R_OG*skew(omega), R0G);    
	P_OG = int(R_OG*v, P0G);
	H_CoG = homogeneous(R_OG,P_OG);

implementation_end;
