       implementation eq
variables
	real R01[3,3];
equations					
   R01 = [ cos(theta1),    -sin(theta1),     0;
           sin(theta1),     cos(theta1),      0;
           0,                     0,         1];


   p2.e = transpose(R01)*p1.e;
   p1.f = R01 * p2.f;
implementation_end;
