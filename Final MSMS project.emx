     connections
      act => FlowSensor1\p1;
      Cns_rot_x\input <= ZeroJunction1\p;
      FlowSensor1\flow -> Splitter3\input;
      FlowSensor1\p2 => ZeroJunction\p;
      int_out <- Splitter2\output;
      Integrate\output -> Splitter\input;
      MTF1\p2 => rotB;
      MTF2\p2 => tranB;
      PowerDemux\input <= rotA;
      PowerDemux\output1 => ZeroJunction1\p;
      PowerDemux\output2 => ZeroJunction2\p;
      PowerDemux\output3 => ZeroJunction\p;
      PowerMux\output => MTF1\p1;
      Splitter\output -> MTF1\theta1;
      Splitter\output -> MTF2\theta1;
      Splitter2\input <- Splitter\output 544 248;
      Splitter3\output -> Integrate\input;
      Splitter3\output -> qd;
      theta_out <- Splitter2\output 448 360;
      ZeroJunction\p => PowerMux\input3;
      ZeroJunction1\p => PowerMux\input1;
      ZeroJunction2\p => Cns_rot_y\input;
      ZeroJunction2\p => PowerMux\input2;
      ZeroJunction4\p <= tranA;
      ZeroJunction4\p => Cns_rot_tran\port1;
      ZeroJunction4\p => MTF2\p1;
     end;
    implementation_end;
   Link1 184 -104
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description><Attributes><GlobalRelations></GlobalRelations></Attributes></Information>';
    type 'Submodel-Graphical'
     ports
      power in tranA [3,1];
      power in rotA [3,1];
      power out tranB [3,1];
      power out rotB [3,1];
     restrictions
      causality preferred in tranA;
      causality preferred in rotA;
      causality preferred in tranB;
      causality preferred in rotB;
    end;
    implementation bg
     submodels
      Euler_eqn 480 192
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         power in tran [3,1];
         power in rot [3,1];
         signal out R_OG [3,3];
         signal out P_OG [3,1];
        parameters
         real m1 = 3.7;
         real J1[3,3] = [0.0067, 0.0, 0.0; 0.0, 0.0064, 0.0; 0.0, 0.0, 0.0067];
       end;
       implementation eq
parameters
	
	real global alpha_a[6];
	real global a_a[6];

variables
  	real omega[3, 1], v[3,1];
	real p[3, 1], h[3, 1];
	real global H01[4,4];
 	real P0G[3,1];
 	real R0G[3,3];
	real global T_FF1_G[4,4];
	real H_FF_G[4,4];
	real H_CoG[4,4];
	
equations
	H_FF_G = H01*T_FF1_G;
	P0G = H_FF_G[1:3,4];
	R0G = H_FF_G[1:3,1:3];
	
	omega = rot.f;   
	v = tran.f; 
	
	p= int(tran.e - skew(omega)*p);
	h= int(rot.e - skew(omega)*h);
	
  	tran.f = p/m1;
  	rot.f =  inverse(J1)*h;

  	R_OG = int(R_OG*skew(omega), R0G);    
	P_OG = int(R_OG*v, P0G);
	H_CoG = homogeneous(R_OG,P_OG);
	

implementation_end;
      gravity_force 600 32
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\Se-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:25</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type 'Se-3'
        ports
         power out p [3,1];
        restrictions
         causality fixed out p;
       end;
       icon bg ellipse bottom
        figures
         text 'Se' 600 32 color 0 18 bold;
       end;
       implementation eq
parameters
	real global m[6];
	real global g;
	real global gravity_yes;
	real effort[3,1] = gravity_yes*[0.0; 0.0; -m[1]*g];
variables
	real flow [3];
equations
	p.e = effort; 
	flow = p.f;
implementation_end;
      MTF_ROG 520 32
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:21</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type 'MTF-3'
        ports
         power in p1 [3,1];
         power out p2 [3,1];
         signal in R_OG [3,3];
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 520 32 color 0 18 bold;
       end;
       implementation eq
equations					
	p2.e = transpose (R_OG) * p1.e;
	p1.f = R_OG * p2.f;
implementation_end;
      plug tranA 104 104;
      plug rotA 96 328;
      plug tranB 800 104;
      plug rotB 800 328;
