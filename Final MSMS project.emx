      Euler_eqn 512 192
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         power in tran [3,1];
         power in rot [3,1];
         signal out R_OG [3,3];
         signal out P_OG [3,1];
        parameters
         real m2 = 8.393;
         real J2[3,3] = [0.0149, 0.0, 0.0; 0.0, 0.3564, 0.0; 0.0, 0.0, 0.3553];
       end;
       implementation eq
parameters
	
	real global alpha_a[6];
	real global a_a[6];

variables
  	real omega[3, 1], v[3,1];
	real p[3, 1], h[3, 1];
	real global H02[4,4];
 	real P0G[3,1];
  	real R0G[3,3];
	real global T_FF2_G[4,4];
	real H_FF_G[4,4];
	real H_CoG[4,4];

equations
	

	H_FF_G = H02*T_FF2_G;
	P0G = H_FF_G[1:3,4];
	R0G = H_FF_G[1:3,1:3];
	
	omega = rot.f;   
	v = tran.f; 
	
	p= int(tran.e - skew(omega)*p);
	h= int(rot.e - skew(omega)*h);
	
  	tran.f = p/m2;
 	rot.f =  inverse(J2)*h;

  	R_OG = int(R_OG*skew(omega), R0G);    
	P_OG = int(R_OG*v, P0G);
	H_CoG = homogeneous(R_OG,P_OG);
	
implementation_end;
