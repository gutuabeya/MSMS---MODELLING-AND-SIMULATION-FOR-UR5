       type TF
        ports
         power in p1;
         power out p2;
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'TF' 336 160 color 0 18 bold;
       end;
       implementation eq
parameters
	real global ratio;
equations
	p2.e = ratio * p1.e;
	p1.f = ratio * p2.f;
implementation_end;
      ZeroJunction 432 160
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
