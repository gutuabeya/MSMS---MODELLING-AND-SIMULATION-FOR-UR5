         power in p1 [3,1];
         power out p2 [3,1];
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'TF' 256 336 color 0 18 bold;
       end;
       implementation eq
parameters
   real alpha_a[6] = [pi/2; 0; 0; pi/2; -pi/2; 0];
	real r[3,3] = [1.0, 0.0,         0.0; 
	               0.0, cos(alpha_a[5]), -sin(alpha_a[5]); 
	               0.0, sin(alpha_a[5]),  cos(alpha_a[5])];
equations					
	p2.e = transpose (r) * p1.e;
	p1.f = r * p2.f;
implementation_end;
      TF3 256 112
