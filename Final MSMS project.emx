</Description>
</Information>';
       type R
        ports
         power in p;
       end;
       icon bg ellipse bottom
        figures
         text 'R' 520 240 color 0 18 bold;
       end;
       implementation eq
parameters
    real B = 6.4e-4;
    real B_p = 0.4;
variables
    real omega;
equations
    omega = p.f;
    p.e = (B*p.f)+tanh(p.f)*B_p;
implementation_end;
