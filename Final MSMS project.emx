</Description>
</Information>';
       knot OneJunction
        ports
         power knot duplicatable none p [1];
         signal knot out flow [1];
        restrictions
         causality constraint one_out p;
       end;
       icon bg ellipse
        figures
         text '1' 248 160 color 0 18 bold;
       end;
       implementation eq
