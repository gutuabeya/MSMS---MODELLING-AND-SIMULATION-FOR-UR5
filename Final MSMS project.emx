         signal out theta;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 440 80 color 0 18 bold;
       end;
       implementation eq
parameters

	real K1 = 4.7e3;
 	real K2 = 6.1e3;
	real K3 = 7.1e3;
	real T1 = 2.0;
	real T2 = 6.9;


variables
	real a;
	real b;
	real t;
	
equations
	
	theta = int(p.f);
	//p.e = theta / c;
	a = T1 / K1;
	b = T1 / K1 + (T2 - T1) / K2;
	
	
  if theta <= a and theta >= -a then
    t = theta * K1;

  else
		if theta > b or theta < -b then
    		t = (theta - sign(theta) * b) * K3 + sign(theta) * T2;
  	  else
			t = (theta - sign(theta) * a) * K2 + sign(theta) * T1;
  		end;

	end;
	
	p.e = t;
	
implementation_end;
