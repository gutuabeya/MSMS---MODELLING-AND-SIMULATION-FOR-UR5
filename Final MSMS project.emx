       implementation eq
parameters
   real alpha_a[6] = [pi/2; 0; 0; pi/2; -pi/2; 0];
	real r[3,3] = [1.0, 0.0,         0.0; 
	               0.0, cos(alpha_a[5]), -sin(alpha_a[5]); 
	               0.0, sin(alpha_a[5]),  cos(alpha_a[5])];
