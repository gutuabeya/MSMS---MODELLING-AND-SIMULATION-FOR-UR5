</Description>
</Information>';
       knot ZeroJunction
        ports
         power knot duplicatable none p [3,1];
         signal knot out effort [3,1];
        restrictions
         causality constraint one_in p;
       end;
       icon bg ellipse
        figures
         text '0' 352 128 color 0 18 bold;
       end;
       implementation eq
equations
	sum (direct (p.f)) = 0;
	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
