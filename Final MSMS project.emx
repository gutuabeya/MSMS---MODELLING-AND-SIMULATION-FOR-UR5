   theta1 80 224
    description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Signal\Sources\MotionProfile.emx</LibraryPath><TimeStamp>2007-12-19 13:45:54</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'MotionProfile-Wizard'
     ports
      signal out theta;
      signal out theta_dot;
    end;
    icon bg bottom
     figures
      rectangle 65 209 95 239 color 0 fill 15132390;
      line 83 220.2 89.4 220.2 color 16711680;
      line 67.7 231.5 92.3 231.5 color 0;
      line 70.3 230.6 74.6 230.6 83.1 219.9 color 16711680;
      line 69.8 216.5 69.8 233.6 color 0;
    end;
    implementation eq
 parameters
	real global theta0_a[6];
	real global theta_d[6];
	real global ti;
	real global tf;
	
 variables
  real hidden fq;
  real hidden fv;
  real hidden rise_time;
  real qi;
  real qf;
  real a0;
  real a1;
  real a2;
  real a3;
  real t;

  real q0;
  real q1;

initialequations
	q0 = theta0_a[1];
	q1 = theta_d[1];
	
 equations
	
	qi = q0;
	qf = q1;
	a0 = qi;
	a1 = 0;
	a2 = (-3*(qi-qf))/tf^2;
	a3 = (2*(qi-qf))/tf^3;
	

	theta = fq;
	theta_dot = fv;
	if time < ti then
		t = 0;
	else
		if time <= tf then
			t = time;
		else
			t = tf;
		end;
	end;
  
	//Third order polynomial trajectories
	fq = a0 + a1*t + a2*(t^2) + a3*(t^3);
	fv = a1 + 2*a2*t + 3*a3*(t^2);


implementation_end;
