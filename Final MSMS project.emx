   Gravity 56 352
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      signal in theta1;
      signal in theta2;
      signal in theta3;
      signal in theta4;
      signal in theta5;
      signal in theta6;
      signal out gravity_comp1;
      signal out gravity_comp2;
      signal out gravity_comp3;
      signal out gravity_comp4;
      signal out gravity_comp5;
      signal out gravity_comp6;
    end;
    implementation eq
parameters
	real global gravity_yes;
	real m[6]=[3.7; 8.393; 2.33; 1.1219; 1.1219; 0.1879];
	
variables
	
	real PE1;
	real PE2;
	real PE3;
	real PE4;
	real PE5;
	real PE6;
	
	real PE_T;
	
equations

  PE1 = m[1]*g_n*0.0635490000000000;
  PE2 = m[2]*g_n*(0.089159 - 0.2125*sin(theta2));
  PE3 = m[3]*g_n*(-0.24225*sin(theta2)*cos(theta3) - 0.425*sin(theta2) - 0.24225*sin(theta3)*cos(theta2) + 0.089159);
  PE4 = m[4]*g_n*(-0.01634*(-sin(theta2)*sin(theta3) + cos(theta2)*cos(theta3))*cos(theta4) + 0.01634*(sin(theta2)*cos(theta3) + sin(theta3)*cos(theta2))*sin(theta4) - 0.39225*sin(theta2)*cos(theta3) - 0.425*sin(theta2) - 0.39225*sin(theta3)*cos(theta2) + 0.089159);
  PE5 = m[5]*g_n*(-0.01634*((-sin(theta2)*sin(theta3) + cos(theta2)*cos(theta3))*sin(theta4) + (sin(theta2)*cos(theta3) + sin(theta3)*cos(theta2))*cos(theta4))*sin(theta5) - 0.09285*(-sin(theta2)*sin(theta3) + cos(theta2)*cos(theta3))*cos(theta4) + 0.09285*(sin(theta2)*cos(theta3) + sin(theta3)*cos(theta2))*sin(theta4) - 0.39225*sin(theta2)*cos(theta3) - 0.425*sin(theta2) - 0.39225*sin(theta3)*cos(theta2) + 0.089159);
  PE6 = m[6]*g_n*(-0.081141*((-sin(theta2)*sin(theta3) + cos(theta2)*cos(theta3))*sin(theta4) + (sin(theta2)*cos(theta3) + sin(theta3)*cos(theta2))*cos(theta4))*sin(theta5) - 0.09465*(-sin(theta2)*sin(theta3) + cos(theta2)*cos(theta3))*cos(theta4) + 0.09465*(sin(theta2)*cos(theta3) + sin(theta3)*cos(theta2))*sin(theta4) - 0.39225*sin(theta2)*cos(theta3) - 0.425*sin(theta2) - 0.39225*sin(theta3)*cos(theta2) + 0.089159);

  PE_T = -0.01*(PE1 + PE2 + PE3 + PE4 + PE5 + PE6);

  gravity_comp1 = gravity_yes*derivative(PE_T,theta1);
  gravity_comp2 = gravity_yes*derivative(PE_T,theta2);
  gravity_comp3 = gravity_yes*derivative(PE_T,theta3);
  gravity_comp4 = gravity_yes*derivative(PE_T,theta4);
  gravity_comp5 = gravity_yes*derivative(PE_T,theta5);
  gravity_comp6 = gravity_yes*derivative(PE_T,theta6);

implementation_end;
   HD1_HFUS20 144 -40
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Graphical'
