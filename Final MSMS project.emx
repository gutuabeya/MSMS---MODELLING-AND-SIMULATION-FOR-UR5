  <Attributes>
    <GlobalRelations>parameters

  	real rG1[3,1]=[0.0;-0.02561;0.00193];
	real rG2[3,1]=[0.2125;0.0;0.11336];
	real rG3[3,1]=[0.15;0.0;0.0265];
	real rG4[3,1]=[0.0;-0.0018;0.01634];  
	real rG5[3,1]=[0.0;0.0018;0.01634]; 
	real rG6[3,1]=[0.0;0.0;-0.001159];  

	real m[6]=[3.7; 8.393; 2.33; 1.1219; 1.1219; 0.1879]; //masses of the link

	//DH parameters
	real alpha_a[6] = [pi/2; 0; 0; pi/2; -pi/2; 0];
  	real a_a[6] = [0; -0.425; -0.39225; 0; 0; 0];
  	real d_a[6] = [0.089159; 0; 0; 0.10915; 0.09465; 0.0823];

	//Initial position
	//real theta0_a[6] = [0; 0; 0; 0; 0; 0];
	real theta0_a[6] = [pi; -pi/3; pi/2; pi/3; pi; 0];

	//Final position
	real theta_d[6] = [pi/3; -pi/6; -pi/6; -pi/4; -pi/4; 2/3*pi];

	real g=g_n; //gravity
	real gravity_yes = 1; //To apply gravity on a link;

	//Joint Constraints
	real stiffness = 1e-10;
	real stif[3,3] = [stiffness,0,0;
                     0,stiffness,0; 
               	   0,0,stiffness];
	real damper = 1e3;
	real dam[3,3] = [damper,0,0;
                     0,damper,0; 
               	   0,0,damper];

	//PID values
	real Kp[6] = [1; 1; 1.5; 2; 2; 2];
	real Kd[6] = [0.001; 0.001; 0.001; 0.0001; 0.0001; 0.0001];
	real Ki[6] = [2; 1.5; 1.5; 2; 2; 2];
	real K[6] = [100; 100; 10; 10; 10; 100];

	real ratio = -100; //Gear ratio

	//For Trajectory generation
	real ti = 0;
	real tf = 3;

	real R_FF_G[3,3] = [1, 0, 0; 0, 1, 0; 0, 0, 1];

variables

  	real H01[4,4];
  	real H02[4,4];
  	real H03[4,4];
  	real H04[4,4];
  	real H05[4,4];
  	real H06[4,4];

  	real H01_d[4,4];
  	real H02_d[4,4];
  	real H03_d[4,4];
  	real H04_d[4,4];
  	real H05_d[4,4];
  	real H06_d[4,4];

	real T_FF1_G[4,4];
	real T_FF2_G[4,4];
	real T_FF3_G[4,4];
	real T_FF4_G[4,4];
	real T_FF5_G[4,4];
	real T_FF6_G[4,4];

equations
	
  T_FF1_G = homogeneous(R_FF_G,rG1);
  T_FF2_G = homogeneous(R_FF_G,rG2);
  T_FF3_G = homogeneous(R_FF_G,rG3);
  T_FF4_G = homogeneous(R_FF_G,rG4);
  T_FF5_G = homogeneous(R_FF_G,rG5);
  T_FF6_G = homogeneous(R_FF_G,rG6);

  //Homogenous Transformation
  H01 = [cos(theta0_a[1]), -sin(theta0_a[1])*cos(alpha_a[1]),  sin(theta0_a[1])*sin(alpha_a[1]),  a_a[1]*cos(theta0_a[1]);
         sin(theta0_a[1]),  cos(theta0_a[1])*cos(alpha_a[1]),  -cos(theta0_a[1])*sin(alpha_a[1]), a_a[1]*sin(theta0_a[1]);
                0,                  sin(alpha_a[1]),                    cos(alpha_a[1]),                  d_a[1]  ;
                0,                         0,                                  0,                             1  ];
  H02 = H01*[cos(theta0_a[2]), -sin(theta0_a[2])*cos(alpha_a[2]),  sin(theta0_a[2])*sin(alpha_a[2]), a_a[2]*cos(theta0_a[2]);
             sin(theta0_a[2]),  cos(theta0_a[2])*cos(alpha_a[2]), -cos(theta0_a[2])*sin(alpha_a[2]), a_a[2]*sin(theta0_a[2]);
                   0,                   sin(alpha_a[2]),                  cos(alpha_a[2]),                 d_a[2]  ;
                   0,                          0,                                0,                          1  ];

  H03 = H02*[cos(theta0_a[3]),  -sin(theta0_a[3])*cos(alpha_a[3]),  sin(theta0_a[3])*sin(alpha_a[3]), a_a[3]*cos(theta0_a[3]);
             sin(theta0_a[3]),  cos(theta0_a[3])*cos(alpha_a[3]),  -cos(theta0_a[3])*sin(alpha_a[3]), a_a[3]*sin(theta0_a[3]);
                    0,                   sin(alpha_a[3]),                    cos(alpha_a[3]),                 d_a[3]  ;
                    0,                         0,                                    0,                         1  ];

  H04 = H03*[cos(theta0_a[4]), -sin(theta0_a[4])*cos(alpha_a[4]),  sin(theta0_a[4])*sin(alpha_a[4]), a_a[4]*cos(theta0_a[4]);
             sin(theta0_a[4]),  cos(theta0_a[4])*cos(alpha_a[4]), -cos(theta0_a[4])*sin(alpha_a[4]), a_a[4]*sin(theta0_a[4]);
                   0,                    sin(alpha_a[4]),                   cos(alpha_a[4]),                d_a[4]  ;
                   0,                           0,                                 0,                         1  ];

  H05 = H04*[cos(theta0_a[5]), -sin(theta0_a[5])*cos(alpha_a[5]),  sin(theta0_a[5])*sin(alpha_a[5]), a_a[5]*cos(theta0_a[5]);
             sin(theta0_a[5]),  cos(theta0_a[5])*cos(alpha_a[5]),  -cos(theta0_a[5])*sin(alpha_a[5]), a_a[5]*sin(theta0_a[5]);
                  0,                   sin(alpha_a[5]),                        cos(alpha_a[5]),               d_a[5]  ;
                  0,                           0,                                      0,                        1  ];

  H06 = H05*[cos(theta0_a[6]), -sin(theta0_a[6])*cos(alpha_a[6]),  sin(theta0_a[6])*sin(alpha_a[6]), a_a[6]*cos(theta0_a[6]);
             sin(theta0_a[6]),  cos(theta0_a[6])*cos(alpha_a[6]),  -cos(theta0_a[6])*sin(alpha_a[6]), a_a[6]*sin(theta0_a[6]);
             0,                         sin(alpha_a[6]),                      cos(alpha_a[6]),                d_a[6]  ;
             0,                                0,                                     0,                         1  ];

  //Homogenous Transformation For Desired Position
  H01_d = [cos(theta_d[1]), -sin(theta_d[1])*cos(alpha_a[1]),  sin(theta_d[1])*sin(alpha_a[1]),  a_a[1]*cos(theta_d[1]);
         sin(theta_d[1]),  cos(theta_d[1])*cos(alpha_a[1]),  -cos(theta_d[1])*sin(alpha_a[1]), a_a[1]*sin(theta_d[1]);
                0,                  sin(alpha_a[1]),                    cos(alpha_a[1]),                  d_a[1]  ;
                0,                         0,                                  0,                             1  ];
  H02_d = H01_d*[cos(theta_d[2]), -sin(theta_d[2])*cos(alpha_a[2]),  sin(theta_d[2])*sin(alpha_a[2]), a_a[2]*cos(theta_d[2]);
             sin(theta_d[2]),  cos(theta_d[2])*cos(alpha_a[2]), -cos(theta_d[2])*sin(alpha_a[2]), a_a[2]*sin(theta_d[2]);
                   0,                   sin(alpha_a[2]),                  cos(alpha_a[2]),                 d_a[2]  ;
                   0,                          0,                                0,                          1  ];

  H03_d = H02_d*[cos(theta_d[3]),  -sin(theta_d[3])*cos(alpha_a[3]),  sin(theta_d[3])*sin(alpha_a[3]), a_a[3]*cos(theta_d[3]);
             sin(theta_d[3]),  cos(theta_d[3])*cos(alpha_a[3]),  -cos(theta_d[3])*sin(alpha_a[3]), a_a[3]*sin(theta_d[3]);
                    0,                   sin(alpha_a[3]),                    cos(alpha_a[3]),                 d_a[3]  ;
                    0,                         0,                                    0,                         1  ];

  H04_d = H03_d*[cos(theta_d[4]), -sin(theta_d[4])*cos(alpha_a[4]),  sin(theta_d[4])*sin(alpha_a[4]), a_a[4]*cos(theta_d[4]);
             sin(theta_d[4]),  cos(theta_d[4])*cos(alpha_a[4]), -cos(theta_d[4])*sin(alpha_a[4]), a_a[4]*sin(theta_d[4]);
                   0,                    sin(alpha_a[4]),                   cos(alpha_a[4]),                d_a[4]  ;
                   0,                           0,                                 0,                         1  ];

  H05_d = H04_d*[cos(theta_d[5]), -sin(theta_d[5])*cos(alpha_a[5]),  sin(theta_d[5])*sin(alpha_a[5]), a_a[5]*cos(theta_d[5]);
             sin(theta_d[5]),  cos(theta_d[5])*cos(alpha_a[5]),  -cos(theta_d[5])*sin(alpha_a[5]), a_a[5]*sin(theta_d[5]);
                  0,                   sin(alpha_a[5]),                        cos(alpha_a[5]),               d_a[5]  ;
                  0,                           0,                                      0,                        1  ];

  H06_d = H05_d*[cos(theta_d[6]), -sin(theta_d[6])*cos(alpha_a[6]),  sin(theta_d[6])*sin(alpha_a[6]), a_a[6]*cos(theta_d[6]);
             sin(theta_d[6]),  cos(theta_d[6])*cos(alpha_a[6]),  -cos(theta_d[6])*sin(alpha_a[6]), a_a[6]*sin(theta_d[6]);
             0,                         sin(alpha_a[6]),                      cos(alpha_a[6]),                d_a[6]  ;
             0,                                0,                                     0,                         1  ];</GlobalRelations>
  </Attributes>
</Information>';
