    implementation bg
     submodels
      C1 432 80
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
       type C
        ports
         power in p;
         signal out theta;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 432 80 color 0 18 bold;
       end;
       implementation eq
parameters

	real K1 = 16e3;
 	real K2 = 25e3;
	real K3 = 29e3;
	real T1 = 7;
	real T2 = 25;


variables
	real a;
	real b;
	real t;
	
equations
	
	theta = int(p.f);
	//p.e = theta / c;
	a = T1 / K1;
	b = T1 / K1 + (T2 - T1) / K2;
	
	
  if theta <= a and theta >= -a then
    t = theta * K1;

  else
		if theta > b or theta < -b then
    		t = (theta - sign(theta) * b) * K3 + sign(theta) * T2;
  	  else
			t = (theta - sign(theta) * a) * K2 + sign(theta) * T1;
  		end;

	end;
	
	p.e = t;
	
implementation_end;
